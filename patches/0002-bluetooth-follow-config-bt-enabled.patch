--- a/components/mr9you__micropython-helper/micropython/ports/esp32/mpconfigport.h	2026-11-18 16:40:00.000000000 +0800
+++ b/components/mr9you__micropython-helper/micropython/ports/esp32/mpconfigport.h	2026-11-18 16:40:00.000000000 +0800
@@ -91,10 +91,24 @@
 #ifndef MICROPY_PY_ESPNOW
 #define MICROPY_PY_ESPNOW                   (1)
 #endif
 #ifndef MICROPY_PY_BLUETOOTH
+// bPuppy 定制: Python 侧蓝牙跟随 IDF 的 CONFIG_BT_ENABLED。
+//
+// 经典 ESP32 台架目标为了 IRAM 整块关掉了蓝牙 (iram0_0_seg 只有 128KB,
+// 预编译的 libbtdm_app 削减不掉)。但 IDF 的 bt 组件不开时, 本文件仍硬开
+// MICROPY_PY_BLUETOOTH=1, 于是 mpnimbleport.c / modbluetooth_nimble.c 会去
+// include "esp_nimble_hci.h" / "host/ble_hs.h" —— 头和库都不在, 直接 fatal error。
+//
+// 为什么不在 CMakeLists 里 -DMICROPY_PY_BLUETOOTH=0: qstr 预处理是一条独立的
+// 自定义命令 (自带 flag 列表), 不吃 IDF 的 COMPILE_OPTIONS。实测 -D 之后
+// 常规目标编译过了, qstr 那一步照样报同样的 fatal error。只有改本文件才两条
+// 路径都生效。S3 上 CONFIG_BT_ENABLED=y ⇒ 行为与上游完全一致。
+#if CONFIG_BT_ENABLED
 #define MICROPY_PY_BLUETOOTH                (1)
 #define MICROPY_PY_BLUETOOTH_USE_SYNC_EVENTS (1)
 #define MICROPY_PY_BLUETOOTH_USE_SYNC_EVENTS_WITH_INTERLOCK (1)
 #define MICROPY_PY_BLUETOOTH_SYNC_EVENT_STACK_SIZE (CONFIG_BT_NIMBLE_TASK_STACK_SIZE)
 #define MICROPY_PY_BLUETOOTH_ENABLE_CENTRAL_MODE (1)
 #define MICROPY_PY_BLUETOOTH_ENABLE_PAIRING_BONDING (1)
 #define MICROPY_BLUETOOTH_NIMBLE            (1)
 #define MICROPY_BLUETOOTH_NIMBLE_BINDINGS_ONLY (1)
+#else
+#define MICROPY_PY_BLUETOOTH                (0)
+#endif
 #endif
 #define MICROPY_PY_HASHLIB_MD5              (1)
 #define MICROPY_PY_HASHLIB_SHA1             (1)
